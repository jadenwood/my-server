{
  "name": "realm-launcher",
  "productName": "Realm Steward",
  "version": "1.0.0",
  "description": "Realm desktop apps from one codebase: Realm Steward (owner: runs up to 4 local test servers) and Realm (player: joins through the player's own Steam copy). Neither modifies game client files.",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Realm",
  "scripts": {
    "start": "electron .",
    "start:player": "electron player/main.js",
    "preview": "node scripts/preview-server.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "screens": "node scripts/electron-screens.mjs",
    "screens:player": "node scripts/player-screens.mjs",
    "screens:doctor": "node scripts/doctor-screens.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js scripts/*.test.mjs",
    "dist:steward": "electron-builder --config build/steward.json --win nsis portable --x64",
    "dist:player": "electron-builder --config build/player.json --win nsis portable --x64",
    "dist:win": "npm run dist:steward",
    "release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
