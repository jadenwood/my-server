{
  "name": "realm-launcher",
  "productName": "Realm",
  "version": "0.1.0",
  "description": "Launcher for the Realm community server. Does not modify game files.",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Realm",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview-server.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "check": "node --check main.js && node --check preload.js && node --check renderer/app.js && node --check renderer/mock-preload.js",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "community.realm.launcher",
    "productName": "Realm",
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "news.json",
      "renderer/**/*"
    ],
    "extraFiles": [
      { "from": "config.json", "to": "config.json" },
      { "from": "news.json", "to": "news.json" }
    ],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "RealmLauncher-${version}-portable.exe"
    }
  }
}
