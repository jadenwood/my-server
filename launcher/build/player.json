{
  "appId": "community.realm.player",
  "productName": "Realm",
  "publish": null,
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "player/main.js",
    "player/preload.js",
    "player/player-config.json",
    "lib/shared/**/*",
    "renderer/player.html",
    "renderer/player.js",
    "renderer/player.css",
    "renderer/doctor.js",
    "renderer/doctor.css",
    "renderer/styles.css",
    "renderer/coach.html",
    "renderer/coach.js",
    "renderer/coach.css",
    "renderer/fonts/**/*",
    "build/icon.png",
    "!node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "player/main.js",
    "name": "realm-player",
    "productName": "Realm",
    "description": "Realm: join the Realm servers through your own Steam copy of Reign of Kings."
  },
  "protocols": [
    {
      "name": "Realm link",
      "schemes": [
        "realm"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Realm",
    "deleteAppDataOnUninstall": false,
    "uninstallDisplayName": "${productName}",
    "runAfterFinish": true,
    "include": "build/player-uninstall.nsh",
    "artifactName": "Realm-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "Realm-${version}-portable.${ext}"
  }
}
