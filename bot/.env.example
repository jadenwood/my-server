# Realm Discord bot settings. Copy this file to ".env" in the same folder and fill it in.
# ".env" is gitignored. Never paste the bot token anywhere else (not in chat, not in the repo).
# Real environment variables override this file.

# --- Discord application (https://discord.com/developers/applications) ---
# Bot > Reset Token. Placeholder only: replace with your own token.
DISCORD_TOKEN=paste-your-bot-token-here
# General Information > Application ID
DISCORD_APPLICATION_ID=000000000000000000
# Your server (guild) ID: Discord Settings > Advanced > Developer Mode, then right-click the server > Copy Server ID.
DISCORD_GUILD_ID=000000000000000000
# Where slash commands are registered on start: guild (instant, this server only), global (up to an hour), off
REALM_REGISTER_COMMANDS=guild

# --- Live status message ---
# Channel for the self-updating status message (right-click the channel > Copy Channel ID). Empty = off.
REALM_STATUS_CHANNEL_ID=
# How often the status message is refreshed, in seconds (minimum 15). It is only edited when something changed.
REALM_STATUS_INTERVAL_SECONDS=60

# --- Where the realm's data comes from (read-only) ---
# The Realm Chronicle service (chronicle/server.js). Keep it on this PC.
REALM_CHRONICLE_URL=http://127.0.0.1:8787
# Oxide's data folder (holds RealmChronicle.json, RealmHouses.json, RealmEvents.json). Same folder as the Chronicle service uses.
REALM_DATA_DIR=G:\RealmTest\server\oxide\data
# Oxide's config folder (holds RealmEvents.json with the event schedule). Empty = the "config" folder next to REALM_DATA_DIR.
REALM_CONFIG_DIR=

# --- What /realm join shows ---
REALM_NAME=The Realm of Ostreval
# Public address players connect to (a DNS name or IP) and the game port.
REALM_JOIN_ADDRESS=play.example.invalid
REALM_JOIN_PORT=7350
# Server id in the Realm player app's signed list (for realm://join/<id>). Empty = not shown.
REALM_SERVER_ID=
# https page where players download the Realm player app. Empty = not shown.
REALM_PLAYER_APP_URL=
# Optional https address of the Realm Portal (public website).
REALM_PORTAL_URL=

# --- Self-service house roles (/realm swear, /realm forswear) ---
# Off by default. Needs the bot's "Manage Roles" permission and its role placed above the "Sworn to ..." roles.
REALM_SWEAR_ENABLED=false
# Create a missing "Sworn to <House>" role (no permissions, house colour) the first time someone swears to that house.
REALM_SWEAR_CREATE_ROLES=true
# Minimum minutes between two oaths by the same member (forswearing is always allowed).
REALM_SWEAR_COOLDOWN_MINUTES=60
# Most "Sworn to ..." roles the bot will ever create.
REALM_SWEAR_MAX_ROLES=25

# --- Bot state (status message id, oath cooldowns). Relative paths are relative to this folder. ---
REALM_BOT_STATE_FILE=state/bot-state.json

# Pictures on the embeds (house sigils, event icons, the realm emblem) from the art pack in art/png.
# false sends text only. The status channel then needs no Attach Files permission.
REALM_EMBED_ART=true
# REALM_ART_DIR=..\art\png
